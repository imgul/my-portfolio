{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog/simple-wins",
      "destination": "/blog/designing-for-non-technical-users",
      "statusCode": 301
    },
    {
      "source": "/blog/simple-wins.md",
      "destination": "/blog/designing-for-non-technical-users.md",
      "statusCode": 301
    },
    {
      "source": "/blog/simple-wins.pdf",
      "destination": "/blog/designing-for-non-technical-users.pdf",
      "statusCode": 301
    },
    {
      "source": "/og/simple-wins.png",
      "destination": "/og/designing-for-non-technical-users.png",
      "statusCode": 301
    },
    {
      "source": "/blog/readme-people-read",
      "destination": "/blog/how-to-write-a-readme",
      "statusCode": 301
    },
    {
      "source": "/blog/readme-people-read.md",
      "destination": "/blog/how-to-write-a-readme.md",
      "statusCode": 301
    },
    {
      "source": "/blog/readme-people-read.pdf",
      "destination": "/blog/how-to-write-a-readme.pdf",
      "statusCode": 301
    },
    {
      "source": "/og/readme-people-read.png",
      "destination": "/og/how-to-write-a-readme.png",
      "statusCode": 301
    },
    {
      "source": "/blog/code-is-not-a-business",
      "destination": "/blog/validate-saas-idea",
      "statusCode": 301
    },
    {
      "source": "/blog/code-is-not-a-business.md",
      "destination": "/blog/validate-saas-idea.md",
      "statusCode": 301
    },
    {
      "source": "/blog/code-is-not-a-business.pdf",
      "destination": "/blog/validate-saas-idea.pdf",
      "statusCode": 301
    },
    {
      "source": "/og/code-is-not-a-business.png",
      "destination": "/og/validate-saas-idea.png",
      "statusCode": 301
    },
    {
      "source": "/blog/distribution-beats-features",
      "destination": "/blog/selling-software-to-schools",
      "statusCode": 301
    },
    {
      "source": "/blog/distribution-beats-features.md",
      "destination": "/blog/selling-software-to-schools.md",
      "statusCode": 301
    },
    {
      "source": "/blog/distribution-beats-features.pdf",
      "destination": "/blog/selling-software-to-schools.pdf",
      "statusCode": 301
    },
    {
      "source": "/og/distribution-beats-features.png",
      "destination": "/og/selling-software-to-schools.png",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/rss.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/feed.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/feed+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(llms|llms-full)\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/blog/:slug([a-z0-9-]+)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Link",
          "value": "<https://gulzaib.vercel.app/blog/:slug>; rel=\"canonical\""
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/feeds/(.*)\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/atom+xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/feeds/(.*)\\.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/feed+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/blog/:slug([a-z0-9-]+)\\.pdf",
      "headers": [
        {
          "key": "Link",
          "value": "<https://gulzaib.vercel.app/blog/:slug>; rel=\"canonical\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/link-icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/link-previews.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/downloads/(.*)\\.sql",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    }
  ],
  "functions": {
    "api/link-preview.js": {
      "maxDuration": 15
    }
  }
}
